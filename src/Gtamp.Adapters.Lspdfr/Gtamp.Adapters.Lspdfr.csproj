<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net48 is what ships; netstandard2.0 exists so the net8.0 test project can
         reference the adapter and exercise it without a Windows game process. -->
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <RootNamespace>Gtamp.Adapters.Lspdfr</RootNamespace>
    <AssemblyName>Gtamp.Adapters.Lspdfr</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gtamp.Shared\Gtamp.Shared.csproj" />
    <ProjectReference Include="..\Gtamp.Client.Core\Gtamp.Client.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The channel framing and the LSPDFR payload merge are internal on purpose:
         they are a wire contract between two hosts, not an API for mods. The test
         project checks them directly rather than only through their callers. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Gtamp.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
