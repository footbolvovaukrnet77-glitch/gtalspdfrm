+HRESULT XGameUiShowMultiplayerActivityGameInviteAsync_impl(void*, task::AsyncBlock* async, void* user) {
+  if (!async || !user) return E_INVALIDARG;
+  const void* identity = reinterpret_cast<const void*>(&XGameUiShowMultiplayerActivityGameInviteAsync_impl);
+  ui::Callbacks callbacks = ui::title_callbacks();
+  if (!callbacks.showMultiplayerActivityGameInvite) return begin_without_ui(async, identity, "XGameUiShowMultiplayerActivityGameInviteAsync");
+  auto show = [callbacks, user](void* handle, task::Queue* queue) {
+    callbacks.showMultiplayerActivityGameInvite(handle, queue, user, callbacks.context);
+  };
+  return ui::begin_title_ui(async, identity, "XGameUiShowMultiplayerActivityGameInviteAsync", ui::Request::MultiplayerActivityGameInvite, show);
+}
+HRESULT XGameUiShowMultiplayerActivityGameInviteResult_impl(void*, task::AsyncBlock* async) {
+  return result_without_payload(async, reinterpret_cast<const void*>(&XGameUiShowMultiplayerActivityGameInviteAsync_impl));
+}
+
+// XGameUiUiCallbacks has no state-share callback, so this dialog is always headless.
+HRESULT XGameUiShowStateShareAsync_impl(void*, task::AsyncBlock* async, void* user, const char* linkToken) {
+  if (!async || !user || !linkToken) return E_INVALIDARG;
+  return begin_without_ui(async, reinterpret_cast<const void*>(&XGameUiShowStateShareAsync_impl), "XGameUiShowStateShareAsync");
+}
+HRESULT XGameUiShowStateShareResult_impl(void*, task::AsyncBlock* async) {
+  return result_without_payload(async, reinterpret_cast<const void*>(&XGameUiShowStateShareAsync_impl));
+}
+
+// In-game text entry (XGameUiTextEntry*): no keyboard is ever shown. A handle keeps the title's initial text and cursor;
+// its first GetState reports Dismissed, as if the player closed the keyboard without typing, and later calls report no change.
+// XGameUiUiCallbacks has no text entry callback, so the title cannot draw this one itself.
+struct TextEntryOptions {
+  uint32_t inputScope;
+  uint32_t positionHint;
+  uint32_t visibilityFlags;
+};
+struct TextEntryExtents {
+  float left, top, right, bottom;
+};
+constexpr uint32_t kTextEntryChangeNone = 0x00;
+constexpr uint32_t kTextEntryChangeDismissed = 0x02;
+constexpr uint32_t kTextEntryPositionHintTop = 1;     // Bottom = 0, Top = 1
+constexpr uint32_t kTextEntryVisibilityKnown = 0x01;  // OnlyShowCandidates
+
+struct TextEntry {
+  std::string text;
+  uint32_t cursor;
+  bool dismissReported;
+};
+
+std::mutex g_text_entry_lock;
+std::unordered_map<const TextEntry*, std::unique_ptr<TextEntry>> g_text_entries;
+
+bool valid_position_hint(uint32_t hint) { return hint <= kTextEntryPositionHintTop; }
+bool valid_visibility(uint32_t flags) { return (flags & ~kTextEntryVisibilityKnown) == 0; }
+
+// maxLength only limits what a player could type; nobody types here, so it is not checked against the initial text.
+HRESULT XGameUiTextEntryOpen_impl(void*, const TextEntryOptions* options, uint32_t, const char* initialText, uint32_t initialCursorIndex,
+                                  TextEntry** handle) {
+  if (handle) *handle = nullptr;
+  if (!options || !handle) return E_INVALIDARG;
+  if (!valid_position_hint(options->positionHint) || !valid_visibility(options->visibilityFlags)) return E_INVALIDARG;
+  auto entry = std::make_unique<TextEntry>(TextEntry{initialText ? initialText : "", 0, false});
+  entry->cursor = initialCursorIndex < entry->text.size() ? initialCursorIndex : static_cast<uint32_t>(entry->text.size());
+  TextEntry* raw = entry.get();
+  {
+    std::lock_guard<std::mutex> lock(g_text_entry_lock);
+    g_text_entries.emplace(raw, std::move(entry));
+  }
+  handles::opened(raw, handles::Type::GameUiTextEntry);
+  *handle = raw;
+  return S_OK;
+}
+
+HRESULT XGameUiTextEntryClose_impl(void*, TextEntry* handle) {
+  std::unique_ptr<TextEntry> entry;
+  {
+    std::lock_guard<std::mutex> lock(g_text_entry_lock);
+    auto found = g_text_entries.find(handle);
+    if (found == g_text_entries.end()) return E_INVALIDARG;
+    entry = std::move(found->second);
+    g_text_entries.erase(found);
+  }
+  // Reported outside the lock: the XSystemHandleTrack callback may call back into the runtime.
+  handles::closed(handle);
+  return S_OK;
+}
