 .../xbox/platform/xgr/runtime/impl_system.cpp | 130 ++++++++++++++++-
 tools/xbox/platform/xgr/test_ui.cpp           | 133 ++++++++++++++++++
 6 files changed, 277 insertions(+), 14 deletions(-)

