+  if (!changeType) return E_INVALIDARG;
+  std::lock_guard<std::mutex> lock(g_text_entry_lock);
+  if (!g_text_entries.count(handle)) return E_INVALIDARG;
+  if (!buffer || bufferSize < handle->text.size() + 1) return HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER);
+  std::memcpy(buffer, handle->text.c_str(), handle->text.size() + 1);
+  *changeType = handle->dismissReported ? kTextEntryChangeNone : kTextEntryChangeDismissed;
+  handle->dismissReported = true;
+  if (cursorIndex) *cursorIndex = handle->cursor;
+  // No IME composition: an empty clause at the cursor.
+  if (imeClauseStartIndex) *imeClauseStartIndex = handle->cursor;
+  if (imeClauseEndIndex) *imeClauseEndIndex = handle->cursor;
+  return S_OK;
