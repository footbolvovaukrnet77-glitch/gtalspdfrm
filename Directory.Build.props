<Project>
  <PropertyGroup>
    <!-- Pinned, not `latest`. `latest` follows whatever SDK happens to be installed,
         so installing a newer one silently changes the language the code is compiled
         as: the .NET 10 SDK compiles this as C# 14, where `field` became a keyword
         inside property accessors and an ordinary local variable stopped building.
         Bumping this is a deliberate edit, which is the point. -->
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <Product>GTAMP — GTA V Universal Multiplayer Framework</Product>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <NoWarn>$(NoWarn);NU1701;CS1591</NoWarn>
  </PropertyGroup>
</Project>
